# Copy to .env and fill real keys. Never commit real secrets.

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Tavily
TAVILY_API_KEY=

# Runtime
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WORKSPACE_ROOT=
# 本地知识库根目录（默认 ai_dev_researcher/knowledge_base，可不填）
# KNOWLEDGE_BASE_ROOT=
# RAG embedding 模型缓存根目录（内含 models--sentence-transformers--* 结构）
# HF_HUB_CACHE=E:/04Programming/Models
# RAG embedding 模型名（默认 all-MiniLM-L6-v2）
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
FAKE_AGENT_MODE=true
