# Copy to .env and fill real keys. Never commit real secrets.

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Tavily
TAVILY_API_KEY=

# Runtime
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WORKSPACE_ROOT=
# 本地知识库根目录（默认 ai_dev_researcher/knowledge_base，可不填）
# KNOWLEDGE_BASE_ROOT=
# RAG embedding 模型缓存根目录（内含 models--sentence-transformers--all-MiniLM-L6-v2
# 之类的 HF 快照目录。指向本地缓存后加载完全离线、零联网重试）
# HF_HUB_CACHE=E:/04Programming/Models
# RAG embedding 模型名（默认 sentence-transformers/all-MiniLM-L6-v2）
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# embedding 离线模式：为 true 时若 HF 缓存缺失则快速失败，不联网下载/重试。
# 也可用环境变量 HF_HUB_OFFLINE=1 临时开启（任选其一）。
# EMBEDDING_OFFLINE=false
# 预留：本地 GGUF embedding 模型路径（离线候选 Qwen3-Embedding-0.6B-GGUF）。
# 当前未接入，留空即不启用。
# GGUF_EMBEDDING_MODEL_PATH=
FAKE_AGENT_MODE=true